# ==============================================================================
# AyuRAG-XAI Environment Configuration Template (.env.example)
# Copy this file to .env and supply actual deployment values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
# Environment: 'development', 'production', or 'test'
DJANGO_ENV=production

# Debug Mode: MUST be False in production
DJANGO_DEBUG=False

# Django Secret Key: Cryptographically random 50+ character string. Required in production.
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-secure-random-50-character-secret-key-for-production!

# Allowed Hosts: Comma-separated list of fully qualified domain names or IP addresses
DJANGO_ALLOWED_HOSTS=api.ayurag.example.com,ayurag.example.com

# Demo Persona Switching: MUST be False in production (disables /api/auth/demo-switch/)
DEMO_MODE=False

# --- CORS & CSRF SECURITY ---
# CORS Allowed Origins: Frontend client origin(s) permitted to make credentialed requests
CORS_ALLOWED_ORIGINS=https://ayurag.example.com,https://app.ayurag.example.com

# CSRF Trusted Origins: Schemes + domains permitted to submit state-changing POST/PATCH requests
CSRF_TRUSTED_ORIGINS=https://ayurag.example.com,https://app.ayurag.example.com

# --- SSL & COOKIE SECURITY ---
# Secure Cookies: Transmit session and CSRF cookies strictly over HTTPS
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# SSL Redirection: Set to True if Django should redirect all HTTP requests to HTTPS
# Set to False if an edge reverse proxy (e.g., Nginx, Caddy, Cloudflare) handles SSL redirection
DJANGO_SECURE_SSL_REDIRECT=False

# HTTP Strict Transport Security (HSTS) duration in seconds (31536000 = 1 year)
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- DATABASE CONFIGURATION ---
# Default is SQLite for local development:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# For PostgreSQL in Production:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ayurag_production
DB_USER=ayurag_app_user
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Or configure via DATABASE_URL:
# DATABASE_URL=postgres://ayurag_app_user:strongpassword@127.0.0.1:5432/ayurag_production

# --- FRONTEND ENVIRONMENT CONFIGURATION ---
# Base API URL used by the Vite React application.
# Set to '/api' when running behind a reverse proxy (Nginx) serving both frontend and backend.
# Set to full URL (e.g. 'https://api.ayurag.example.com/api') when frontend and backend are hosted on separate subdomains.
VITE_API_BASE_URL=/api
